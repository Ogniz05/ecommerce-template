# Frontend environment. Copy to frontend/.env — Vite only exposes keys
# prefixed with VITE_ to the browser, so never put a secret here: everything
# in this file ships to every visitor.

# API base. Leave unset in development to use the Vite proxy at /api.
# In production this must include the /api suffix, e.g.
# VITE_API_URL=https://your-backend.example.com/api
VITE_API_URL=

# [CUSTOMIZE] Stripe publishable key (pk_test_... / pk_live_...).
# Publishable by design — the secret key belongs in the backend .env only.
VITE_STRIPE_PUBLIC_KEY=

# ── Crash reporting (optional) ───────────────────────────────────────
# Leave empty and monitoring stays completely inert: no SDK init, no
# network calls, no third-party data sharing to disclose. Set the DSN to
# turn it on. Session replay is disabled in code — a storefront replay
# would record card and address fields.
VITE_SENTRY_DSN=

# Tags crash reports with the deployed version. Wire to your CI commit SHA.
VITE_APP_VERSION=dev

# ── Product analytics (optional) ─────────────────────────────────────
# Leave empty and nothing is loaded or sent. When set, the provider
# script is injected only after the visitor opts in via the cookie
# banner — declining means no third party ever sees the visit.
# Events carry product ids and values only, never personal data.
VITE_GA_MEASUREMENT_ID=

# ── Beta programme (optional) ────────────────────────────────────────
# "on" shows the tester feedback button. Leave empty in production: a
# live storefront should not carry a bug-report button.
VITE_BETA_FEEDBACK=
